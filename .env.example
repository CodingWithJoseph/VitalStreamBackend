ENVIRONMENT=development
DATABASE_URL=sqlite:///./vitalstream.db
OIDC_ISSUER_URL=http://10.0.2.2:8080/realms/vitalstream
OIDC_JWKS_URL=http://localhost:8080/realms/vitalstream/protocol/openid-connect/certs
OIDC_AUDIENCE=vitalstream-api
ALLOW_SYNTHETIC=true
# Required only for Compose. Set these locally; never commit the resulting .env.
POSTGRES_PASSWORD=replace-with-a-local-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-another-local-password
