{
  "realm": "vitalstream",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "sslRequired": "none",
  "clients": [{
    "clientId": "vitalstream-android",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["com.vitalstream.android:/oauth2redirect"],
    "attributes": {"pkce.code.challenge.method": "S256"},
    "protocolMappers": [{
      "name": "api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {"included.custom.audience": "vitalstream-api", "access.token.claim": "true", "id.token.claim": "false"}
    }]
  }]
}
